# Non-secret template for the service manager; replace every REPLACE_* value.
# Same physical rail order on all ranks; actual HCA/GID values may differ.
ALASKA_ROCE_RAILS=REPLACE_HCA_RAIL0:3,REPLACE_HCA_RAIL1:3
NCCL_SOCKET_IFNAME=REPLACE_MANAGEMENT_INTERFACE
NCCL_IB_HCA=REPLACE_HCA_RAIL0,REPLACE_HCA_RAIL1
NCCL_IB_GID_INDEX=3
NCCL_IB_TC=106
NCCL_CROSS_NIC=0
NCCL_IB_QPS_PER_CONNECTION=1
NCCL_IB_SPLIT_DATA_ON_QPS=0
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_DISABLE=0
NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_NVLS_ENABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IB_MERGE_NICS=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_DEBUG=WARN
ALASKA_EXPERT_LOADS=pdl
ALASKA_EXPERT_DISCARD=1
ALASKA_VERIFY_REUSE_HEAD=1
ALASKA_L2_PREFETCH=1
ALASKA_L2_PREFETCH_LIBRARY=/opt/glm-flash-rs/artifacts/native/libalaska_l2pf.so
ALASKA_L2_PREFETCH_SHA256=REPLACE_WITH_L2_LIBRARY_SHA256
ALASKA_SELECT_SPLIT=1
ALASKA_SPECULATIVE_GREEDY=0
# Shared verification for compatible sampled/greedy foreground cohorts.
# 0 disables batching; 6 selects the documented four-token-per-request policy.
ALASKA_MULTI_GREEDY=6
ALASKA_VERIFY_SPARSE_WINDOW=1
ALASKA_VERIFY_GRAPH_CACHE=1
ALASKA_VERIFY_BATCH_KDA_COMMIT=1
ALASKA_VERIFY_PACKED_SAMPLE=1
ALASKA_PREFILL_ROW_SPLIT=1
ALASKA_PREFILL_DIRECT_BF16=1
# Qualified prefill GEMM shapes use cuBLAS; 0 keeps retained kernels everywhere.
ALASKA_PREFILL_BLAS=1
ALASKA_SKIP_DENSE_INDEX_QUERY=1
ALASKA_CPU_PIN=http
ALASKA_SSD_COPY_WORKER=1
ALASKA_SSD_READ_WAKE=1
ALASKA_SSD_READ_BATCH=1
ALASKA_SSD_FOREGROUND_READ=1
ALASKA_SHARED_EXPERT_OVERLAP=1
ALASKA_DRAFT_READBACK=1
